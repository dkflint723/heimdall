[Desktop Entry]
Type=Application
Version=1.0

Name=Heimdall
GenericName=File Manager
Comment=Browse, search and share files

# %F rather than %f: Heimdall opens several paths at once, and the desktop
# passes them as separate arguments.
Exec=heimdall %F
Icon=heimdall
Terminal=false
StartupNotify=true

# inode/directory is what makes this offerable as the default file manager;
# without it the system will not list Heimdall when you go to change it.
MimeType=inode/directory;

Categories=System;Utility;Core;FileTools;FileManager;
Keywords=files;folders;browse;explorer;manager;network;share;

Actions=NewWindow;Home;

[Desktop Action NewWindow]
Name=Open a New Window
Exec=heimdall

[Desktop Action Home]
Name=Open Home Folder
Exec=heimdall %h
