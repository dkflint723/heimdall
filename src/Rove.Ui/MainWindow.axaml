<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fs="clr-namespace:Rove.Core.FileSystem;assembly=Rove.Core"
        xmlns:vm="clr-namespace:Rove.Ui.ViewModels"
        xmlns:core="clr-namespace:Rove.Core;assembly=Rove.Core"
        xmlns:th="clr-namespace:Rove.Ui.Thumbnails"
        x:Class="Rove.Ui.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="rove"
        Width="1000" Height="680">

  <Window.Resources>

    <!-- Type scale and row metrics in one place, as DynamicResource so Ctrl +/-
         re-writes them at runtime. Every hardcoded 11/12/13 in this file used
         to be its own decision; now there is one. -->
    <x:Double x:Key="FontSizeTiny">11</x:Double>
    <x:Double x:Key="FontSizeSmall">12.5</x:Double>
    <x:Double x:Key="FontSizeBase">14</x:Double>
    <x:Double x:Key="FontSizeLarge">15.5</x:Double>
    <x:Double x:Key="RowHeight">34</x:Double>
    <x:Double x:Key="ThumbSize">26</x:Double>
    <x:Double x:Key="IconSize">17</x:Double>
    <x:Double x:Key="RailWidth">44</x:Double>
    <x:Double x:Key="ColumnStripHeight">108</x:Double>

    <!-- Colours from the Okabe-Ito palette, which is designed to stay
         distinguishable under deuteranopia, protanopia and tritanopia. The
         accent and the active-pane marker are a blue/orange pair rather than
         anything red/green, and they also differ in lightness so they survive
         being seen in greyscale.

         The rule this sets for the rest of the app: hue never carries meaning
         on its own. Anything colour-coded also gets position, shape or text —
         which is what makes file-age shading and tags workable at all. -->
    <SolidColorBrush x:Key="AccentBrush">#56B4E9</SolidColorBrush>
    <SolidColorBrush x:Key="AccentDimBrush">#1E3A4C</SolidColorBrush>
    <SolidColorBrush x:Key="ActivePaneBrush">#E69F00</SolidColorBrush>

    <!-- Both halves of a split render from this one template. The split is two
         instances of the same view, not a second code path — which is why
         PaneViewModel was built to own its own path, history and selection. -->
    <DataTemplate x:Key="PaneGroupTemplate" x:DataType="vm:PaneGroupViewModel">
      <DockPanel>

        <Border DockPanel.Dock="Top" Background="#141414" Padding="6,4,6,0">
         <DockPanel>
          <!-- Per-pane, so in a split each side toggles its own chain. Binds
               through this group's ActiveTab rather than the shell's, which
               would only ever be the focused half. -->
          <ToggleButton DockPanel.Dock="Right" Content="&#x2AFC;"
                        FontSize="{DynamicResource FontSizeLarge}" Padding="8,2"
                        Margin="6,0,0,4" VerticalAlignment="Center"
                        IsChecked="{Binding ActiveTab.IsColumnsView, Mode=OneWay}"
                        Command="{Binding ActiveTab.ToggleViewCommand}"
                        ToolTip.Tip="column view  (f8)"/>
          <StackPanel Orientation="Horizontal">
          <TabStrip ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}">
            <TabStrip.ItemTemplate>
              <DataTemplate x:DataType="vm:PaneViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBase}" VerticalAlignment="Center"/>
                  <Button Content="&#x2715;" FontSize="9" Opacity="0.45"
                          Background="Transparent" BorderThickness="0"
                          Padding="2" VerticalAlignment="Center"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CloseTabCommand}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </TabStrip.ItemTemplate>
          </TabStrip>
          <Button Content="+" FontSize="{DynamicResource FontSizeLarge}" Opacity="0.45"
                  Background="Transparent" BorderThickness="0"
                  Padding="10,2" VerticalAlignment="Center"
                  Command="{Binding NewTabHereCommand}"
                  ToolTip.Tip="new tab in this pane  (ctrl+t)"/>
          </StackPanel>
         </DockPanel>
        </Border>

        <!-- The only cue for which half takes the next keystroke, so it has to
             be visible but quiet. -->
        <Border DockPanel.Dock="Bottom" Height="3"
                Background="{DynamicResource ActivePaneBrush}"
                IsVisible="{Binding IsActiveGroup}"/>

        <ItemsControl ItemsSource="{Binding Tabs}" Background="#0F0F0F">

          <ItemsControl.ContextMenu>
            <ContextMenu x:DataType="vm:PaneGroupViewModel">
              <ContextMenu.Styles>
                <Style Selector="ContextMenu ScrollViewer">
                  <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                  <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                </Style>
              </ContextMenu.Styles>
              <MenuItem Header="Open"
                        Command="{Binding ActiveTab.OpenSelectedCommand}"/>
              <MenuItem Header="Open with"
                        ItemsSource="{Binding ActiveTab.OpenWithOptions}">
                <MenuItem.ItemTemplate>
                  <DataTemplate x:DataType="fs:LaunchOption">
                    <TextBlock Text="{Binding Name}"/>
                  </DataTemplate>
                </MenuItem.ItemTemplate>
                <MenuItem.Styles>
                  <Style Selector="MenuItem > MenuItem" x:DataType="fs:LaunchOption">
                    <Setter Property="Command"
                            Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ActiveTab.OpenWithAppCommand}"/>
                    <Setter Property="CommandParameter" Value="{Binding}"/>
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
              <Separator/>
              <MenuItem Header="Copy"  Command="{Binding ActiveTab.CopySelectionToClipboardCommand}"/>
              <MenuItem Header="Cut"   Command="{Binding ActiveTab.CutSelectionToClipboardCommand}"/>
              <MenuItem Header="Paste" Command="{Binding ActiveTab.PasteCommand}"/>
              <Separator/>
              <MenuItem Header="Copy to other pane"
                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CopyToOtherPaneCommand}"
                        IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsSplit}"/>
              <MenuItem Header="Move to other pane"
                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).MoveToOtherPaneCommand}"
                        IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsSplit}"/>
              <Separator/>
              <MenuItem Header="Rename"        Command="{Binding ActiveTab.BeginRenameCommand}"/>
              <MenuItem Header="Move to trash" Command="{Binding ActiveTab.TrashSelectedCommand}"/>
              <Separator/>
              <MenuItem Header="New folder"          Command="{Binding ActiveTab.NewFolderCommand}"/>
              <MenuItem Header="Open terminal here"  Command="{Binding ActiveTab.OpenTerminalHereCommand}"/>
              <Separator/>
              <MenuItem Header="Scripts" ItemsSource="{Binding ActiveTab.Scripts}"
                        IsVisible="{Binding ActiveTab.HasScripts}">
                <MenuItem.ItemTemplate>
                  <DataTemplate x:DataType="core:ScriptCommand">
                    <TextBlock Text="{Binding Name}"/>
                  </DataTemplate>
                </MenuItem.ItemTemplate>
                <MenuItem.Styles>
                  <Style Selector="MenuItem > MenuItem" x:DataType="core:ScriptCommand">
                    <Setter Property="Command"
                            Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ActiveTab.RunScriptCommand}"/>
                    <Setter Property="CommandParameter" Value="{Binding}"/>
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
              <MenuItem Header="Scripts folder…"
                        Command="{Binding ActiveTab.OpenScriptsFolderCommand}"/>
              <Separator/>
              <MenuItem Header="Properties"
                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowPropertiesCommand}"/>
            </ContextMenu>
          </ItemsControl.ContextMenu>

          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Grid/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PaneViewModel">
              <!-- Every pane's view stays alive, toggled by IsVisible rather
                   than swapped through a ContentControl, so switching tabs
                   never resets scroll position. -->
              <Panel IsVisible="{Binding IsActive}" DragDrop.AllowDrop="True">

              <DockPanel>

              <!-- Miller columns as a navigation strip above the listing, not
                   instead of it. The chain is for getting around; the list
                   below keeps the detail columns, multi-select and every
                   operation working on a plain list. -->
              <Border DockPanel.Dock="Top"
                      Height="{DynamicResource ColumnStripHeight}"
                      BorderThickness="0,0,0,0.5" BorderBrush="#242424"
                      IsVisible="{Binding IsColumnsView}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Miller.Columns}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MillerColumnViewModel">
                      <Border Width="210" BorderThickness="0,0,0.5,0" BorderBrush="#242424">
                        <ListBox ItemsSource="{Binding Entries}"
                                 SelectedItem="{Binding SelectedEntry}"
                                 Background="Transparent" Padding="0">
                          <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                              <Setter Property="Padding" Value="0"/>
                              <Setter Property="MinHeight" Value="0"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                              <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
                              <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                              <Setter Property="Background" Value="Transparent"/>
                            </Style>
                          </ListBox.Styles>
                          <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                              <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                          </ListBox.ItemsPanel>
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="fs:FileEntry">
                              <Panel>
                                <Border Background="{DynamicResource AccentDimBrush}"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                <Border Width="3" HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                <Grid ColumnDefinitions="*,Auto" Height="{DynamicResource RowHeight}" Margin="12,0,8,0">
                                  <TextBlock Grid.Column="0" Text="{Binding Name}"
                                             FontSize="{DynamicResource FontSizeBase}" VerticalAlignment="Center"
                                             TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Grid.Column="1" Text="&#x203A;" FontSize="{DynamicResource FontSizeBase}"
                                             Opacity="0.35" VerticalAlignment="Center"
                                             IsVisible="{Binding IsDirectory}"/>
                                </Grid>
                              </Panel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              </Border>

              <!-- Below the chain, because it labels the listing rather than
                   the strip. Column widths and margin match the row template so
                   the headings actually sit over their columns. -->
              <Border DockPanel.Dock="Top" Padding="0,3" Background="#202020">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="12,0,8,0">
                  <Border Grid.Column="0" Width="{DynamicResource ThumbSize}" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="1" Text="name"
                             FontSize="{DynamicResource FontSizeSmall}" Opacity="0.45"/>
                  <TextBlock Grid.Column="2" Width="120" Margin="8,0,0,0" Text="info"
                             IsVisible="{Binding ShowMetadata}"
                             FontSize="{DynamicResource FontSizeSmall}" Opacity="0.45"/>
                  <TextBlock Grid.Column="3" Width="100" Margin="8,0,0,0" Text="permissions"
                             IsVisible="{Binding ShowPermissions}"
                             FontSize="{DynamicResource FontSizeSmall}" Opacity="0.45"/>
                  <TextBlock Grid.Column="4" Width="100" Text="size"
                             IsVisible="{Binding ShowSize}"
                             FontSize="{DynamicResource FontSizeSmall}" Opacity="0.45"/>
                  <TextBlock Grid.Column="5" Width="170" Text="modified"
                             IsVisible="{Binding ShowModified}"
                             FontSize="{DynamicResource FontSizeSmall}" Opacity="0.45"/>
                </Grid>
              </Border>

              <ListBox ItemsSource="{Binding Entries}"
                       SelectedItem="{Binding SelectedEntry}"
                       SelectedItems="{Binding SelectedEntries}"
                       DragDrop.AllowDrop="True"
                       SizeChanged="OnListSizeChanged"
                       SelectionMode="Multiple" Background="Transparent" Padding="0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="fs:FileEntry">
                    <Panel>
                      <!-- Selection marker drawn by us rather than by the control theme.
                           A 3px bar plus a fill means selection reads by position as well
                           as by colour, which the theme default does not. -->
                      <Border Background="{DynamicResource AccentDimBrush}"
                              IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                      <Border Width="3" HorizontalAlignment="Left"
                              Background="{DynamicResource AccentBrush}"
                              IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Height="{DynamicResource RowHeight}" Margin="12,0,8,0">
                        <Image Grid.Column="0" Width="{DynamicResource ThumbSize}" Height="{DynamicResource ThumbSize}" Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               th:ThumbnailImage.Path="{Binding FullPath}"
                               th:ThumbnailImage.Size="64"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                   FontSize="{DynamicResource FontSizeBase}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <!-- Type-specific fact: pixel dimensions for images, child count
                             for folders. First to drop when space runs out. -->
                        <TextBlock Grid.Column="2" Width="120" Margin="8,0,0,0"
                                   th:RowMetadata.Entry="{Binding}"
                                   IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).ShowMetadata}"
                                   FontSize="{DynamicResource FontSizeSmall}" FontFamily="monospace" Opacity="0.45"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <!-- POSIX mode, formatted as ls -l prints it. -->
                        <TextBlock Grid.Column="3" Width="100" Margin="8,0,0,0"
                                   th:RowMetadata.Access="{Binding}"
                                   IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).ShowPermissions}"
                                   FontSize="{DynamicResource FontSizeSmall}" FontFamily="monospace" Opacity="0.5"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Width="100" Text="{Binding Length}"
                                   IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).ShowSize}"
                                   FontSize="{DynamicResource FontSizeSmall}" FontFamily="monospace" Opacity="0.55"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Width="170" Text="{Binding LastWriteTime}"
                                   IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).ShowModified}"
                                   FontSize="{DynamicResource FontSizeSmall}" FontFamily="monospace" Opacity="0.55"
                                   VerticalAlignment="Center"/>
                      </Grid>
                    </Panel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              </DockPanel>

              <!-- Drop target outline. Hit-testing is off so it never eats the
                   drag events it is drawn in response to. -->
              <Border IsVisible="{Binding IsDropTarget}" IsHitTestVisible="False"
                      BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"/>

              <!-- Preview sits over the listing rather than beside it: at this
                   width a side panel would squeeze the list to nothing, and
                   the overlay dismisses with the same key that opened it. -->
              <Border IsVisible="{Binding IsPreviewVisible}"
                      Background="#0C0C0C" BorderThickness="0.5,0,0,0"
                      BorderBrush="#242424" HorizontalAlignment="Right"
                      Width="360" Padding="12">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
                    <TextBlock Text="{Binding PreviewTitle}" FontSize="{DynamicResource FontSizeLarge}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PreviewDetail}" FontSize="{DynamicResource FontSizeTiny}"
                               Opacity="0.45" FontFamily="monospace"/>
                  </StackPanel>

                  <Image Source="{Binding PreviewImage}"
                         IsVisible="{Binding HasPreviewImage}"
                         Stretch="Uniform" VerticalAlignment="Top"/>

                  <ScrollViewer IsVisible="{Binding HasPreviewText}">
                    <TextBlock Text="{Binding PreviewText}" FontSize="{DynamicResource FontSizeSmall}"
                               FontFamily="monospace" TextWrapping="NoWrap"
                               Opacity="0.75"/>
                  </ScrollViewer>
                </DockPanel>
              </Border>

              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>

        </ItemsControl>

      </DockPanel>
    </DataTemplate>

  </Window.Resources>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+T"         Command="{Binding NewTabCommand}"/>
    <KeyBinding Gesture="Ctrl+W"         Command="{Binding CloseTabCommand}"/>
    <KeyBinding Gesture="Ctrl+Tab"       Command="{Binding NextTabCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}"/>
    <KeyBinding Gesture="Alt+Left"       Command="{Binding ActiveTab.GoBackCommand}"/>
    <KeyBinding Gesture="Alt+Right"      Command="{Binding ActiveTab.GoForwardCommand}"/>
    <KeyBinding Gesture="Alt+Up"         Command="{Binding ActiveTab.GoUpCommand}"/>
    <KeyBinding Gesture="F5"             Command="{Binding ActiveTab.RefreshCommand}"/>
    <KeyBinding Gesture="F2"             Command="{Binding ActiveTab.BeginRenameCommand}"/>
    <KeyBinding Gesture="F3"             Command="{Binding ToggleSplitCommand}"/>
    <KeyBinding Gesture="F8"             Command="{Binding ActiveTab.ToggleViewCommand}"/>
    <KeyBinding Gesture="Space"          Command="{Binding ActiveTab.TogglePreviewCommand}"/>
    <KeyBinding Gesture="F4"             Command="{Binding ActiveTab.OpenTerminalHereCommand}"/>
    <KeyBinding Gesture="Ctrl+Z"         Command="{Binding ActiveTab.UndoCommand}"/>
    <KeyBinding Gesture="Ctrl+C"         Command="{Binding ActiveTab.CopySelectionToClipboardCommand}"/>
    <KeyBinding Gesture="Ctrl+X"         Command="{Binding ActiveTab.CutSelectionToClipboardCommand}"/>
    <KeyBinding Gesture="Ctrl+V"         Command="{Binding ActiveTab.PasteCommand}"/>
    <KeyBinding Gesture="Ctrl+I"         Command="{Binding ActiveTab.ToggleFilterCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+N"   Command="{Binding ActiveTab.NewFolderCommand}"/>
    <KeyBinding Gesture="Ctrl+OemPlus"   Command="{Binding ZoomInCommand}"/>
    <KeyBinding Gesture="Ctrl+OemMinus"  Command="{Binding ZoomOutCommand}"/>
    <KeyBinding Gesture="Ctrl+D0"        Command="{Binding ZoomResetCommand}"/>
    <KeyBinding Gesture="Ctrl+B"         Command="{Binding Sidebar.CycleRailCommand}"/>
    <KeyBinding Gesture="Ctrl+D"         Command="{Binding PinCurrentCommand}"/>
    <!-- Alt rather than Ctrl for panels: Ctrl+1..9 already switches tabs,
         browser-style, and that convention is the stronger one. -->
    <KeyBinding Gesture="Alt+D1"         Command="{Binding Sidebar.ShowPanelCommand}" CommandParameter="places"/>
    <KeyBinding Gesture="Alt+D2"         Command="{Binding Sidebar.ShowPanelCommand}" CommandParameter="tree"/>
    <KeyBinding Gesture="Alt+D3"         Command="{Binding Sidebar.ShowPanelCommand}" CommandParameter="search"/>
    <KeyBinding Gesture="Ctrl+F"         Command="{Binding Sidebar.ShowPanelCommand}" CommandParameter="search"/>
  </Window.KeyBindings>

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="8,6" Background="#181818">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="&#x2190;" Command="{Binding ActiveTab.GoBackCommand}"
                IsEnabled="{Binding ActiveTab.CanGoBack}" Width="32"/>
        <Button Content="&#x2192;" Command="{Binding ActiveTab.GoForwardCommand}"
                IsEnabled="{Binding ActiveTab.CanGoForward}" Width="32"/>
        <Button Content="&#x2191;" Command="{Binding ActiveTab.GoUpCommand}"
                IsEnabled="{Binding ActiveTab.CanGoUp}" Width="32"/>
        <TextBox x:Name="PathBox" Text="{Binding ActiveTab.PathText}" MinWidth="320"
                 FontFamily="monospace" FontSize="{DynamicResource FontSizeBase}"/>
        <CheckBox Content="hidden" IsChecked="{Binding ActiveTab.ShowHidden}"/>
        <ToggleButton Content="&#x25EB;" FontSize="{DynamicResource FontSizeBase}" Padding="8,3"
                      IsChecked="{Binding IsSplit, Mode=OneWay}"
                      Command="{Binding ToggleSplitCommand}"
                      ToolTip.Tip="split view  (f3)"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Padding="8,5" Background="#1d1d1d"
            IsVisible="{Binding ActiveTab.IsFilterVisible}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="filter" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.5" VerticalAlignment="Center"/>
        <TextBox x:Name="FilterBox" Text="{Binding ActiveTab.FilterText}"
                 Width="300" FontFamily="monospace" FontSize="{DynamicResource FontSizeBase}"/>
        <TextBlock Text="esc to clear" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.35" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#181818">
      <TextBlock Text="{Binding ActiveTab.Status}" FontFamily="monospace"
                 FontSize="{DynamicResource FontSizeSmall}" Opacity="0.7"/>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,5" Background="#1d1d1d"
            IsVisible="{Binding ActiveOperation, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding OperationStatus}" FontFamily="monospace"
                   FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
        <Button Content="cancel" FontSize="{DynamicResource FontSizeSmall}" Padding="8,2"
                Command="{Binding CancelOperationCommand}"/>
      </StackPanel>
    </Border>

    <!-- Inline bar rather than a modal dialog: when you are about to destroy
         something you want the listing still visible behind the question. -->
    <Border x:Name="PromptBar" DockPanel.Dock="Bottom" Padding="8,6"
            Background="#232323" IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="PromptLabel" FontSize="{DynamicResource FontSizeBase}" VerticalAlignment="Center"/>
        <TextBox x:Name="PromptInput" Width="320" FontFamily="monospace"
                 FontSize="{DynamicResource FontSizeBase}" IsVisible="False"/>
        <!-- Real buttons, not just a keystroke. A destructive confirmation
             needs a clickable affordance, and a focused Button answers Enter
             through the control system rather than through a hand-rolled key
             handler that can be intercepted anywhere along the route. -->
        <Button x:Name="PromptConfirm" IsVisible="False" Padding="12,3"
                FontSize="{DynamicResource FontSizeSmall}"/>
        <Button x:Name="PromptCancel" Content="cancel" IsVisible="False" Padding="12,3"
                FontSize="{DynamicResource FontSizeSmall}"/>
        <TextBlock x:Name="PromptHint" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.5" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Left" Background="#141414" Width="{DynamicResource RailWidth}"
            IsVisible="{Binding Sidebar.IsRailVisible}">
      <StackPanel Orientation="Vertical" Spacing="4" Margin="0,8">
        <Button Content="&#x2605;" FontSize="{DynamicResource IconSize}" Width="{DynamicResource RailWidth}" Height="40"
                Background="Transparent" BorderThickness="0"
                Command="{Binding Sidebar.ShowPanelCommand}" CommandParameter="places"
                ToolTip.Tip="places  (alt+1)"/>
        <Button Content="&#x25B8;" FontSize="{DynamicResource IconSize}" Width="{DynamicResource RailWidth}" Height="40"
                Background="Transparent" BorderThickness="0"
                Command="{Binding Sidebar.ShowPanelCommand}" CommandParameter="tree"
                ToolTip.Tip="tree  (alt+2)"/>
        <Button Content="&#x2315;" FontSize="{DynamicResource IconSize}" Width="{DynamicResource RailWidth}" Height="40"
                Background="Transparent" BorderThickness="0"
                Command="{Binding Sidebar.ShowPanelCommand}" CommandParameter="search"
                ToolTip.Tip="search  (ctrl+f)"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Left" Background="#181818"
            Width="{Binding Sidebar.Width}"
            IsVisible="{Binding Sidebar.IsPanelVisible}">
      <Panel>

        <ScrollViewer IsVisible="{Binding Sidebar.IsPlacesVisible}">
          <ItemsControl ItemsSource="{Binding Sidebar.Groups}" Margin="0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PlaceGroupViewModel">
                <StackPanel Margin="0,0,0,10">
                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.4"
                             Margin="12,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding Places}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PlaceItemViewModel">
                        <Button Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).GoToPlaceCommand}"
                                CommandParameter="{Binding Path}"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,3" Opacity="{Binding Opacity}">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeBase}"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Value="{Binding UsedFraction}" Maximum="1"
                                         Height="3" Margin="0,4,8,0"
                                         IsVisible="{Binding HasCapacity}"/>
                            <TextBlock Text="{Binding CapacityText}" FontSize="{DynamicResource FontSizeTiny}"
                                       Opacity="0.4" IsVisible="{Binding HasCapacity}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <DockPanel IsVisible="{Binding Sidebar.IsSearchVisible}" Margin="8,8">
          <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBox x:Name="SearchBox" Text="{Binding Sidebar.Search.Query}"
                     PlaceholderText="search…" FontSize="{DynamicResource FontSizeBase}"/>
            <CheckBox Content="this folder only" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding Sidebar.Search.ScopeToCurrentFolder}"/>
            <TextBlock Text="{Binding Sidebar.Search.Status}" FontSize="{DynamicResource FontSizeTiny}"
                       Opacity="0.45" FontFamily="monospace"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
          </StackPanel>

          <ListBox ItemsSource="{Binding Sidebar.Search.Results}"
                   Background="Transparent" Padding="0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
              </Style>
              <!-- A left edge bar as well as a fill: selection stays legible
                   without relying on the colour being perceived. -->
              <!-- The theme's own selection fill is suppressed; the row
                   template draws the cue so it is guaranteed to appear. -->
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="fs:FileEntry">
                <Button Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.Search.OpenCommand}"
                        CommandParameter="{Binding}"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="4,3">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBase}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FullPath}" FontSize="{DynamicResource FontSizeTiny}" Opacity="0.35"
                               FontFamily="monospace"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <TreeView ItemsSource="{Binding Sidebar.Tree.Roots}"
                  IsVisible="{Binding Sidebar.IsTreeVisible}"
                  Background="Transparent" Margin="4,8">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:FolderNode" ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeBase}"
                         TextTrimming="CharacterEllipsis"/>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:FolderNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            </Style>
          </TreeView.Styles>
        </TreeView>

      </Panel>
    </Border>

    <Grid x:Name="SplitGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding LeftColumnWidth}"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="{Binding RightColumnWidth}"/>
      </Grid.ColumnDefinitions>

      <ContentControl Grid.Column="0" Content="{Binding Left}"
                      ContentTemplate="{StaticResource PaneGroupTemplate}"/>

      <GridSplitter x:Name="SplitHandle" Grid.Column="1" Width="4"
                    Background="#0A0A0A" ResizeDirection="Columns"
                    IsVisible="{Binding IsSplit}"/>

      <ContentControl Grid.Column="2" Content="{Binding Right}"
                      ContentTemplate="{StaticResource PaneGroupTemplate}"
                      IsVisible="{Binding IsSplit}"/>
    </Grid>

  </DockPanel>
</Window>
