<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Heimdall.Ui.ViewModels"
        x:Class="Heimdall.Ui.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Heimdall settings"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource ViewText}"
        FontFamily="{DynamicResource AppFontFamily}"
        Width="700" Height="560"
        WindowStartupLocation="CenterOwner">

  <!-- NO margin on the shell. It used to be 16 all round, which inset the tab
       strip from the window edges so the sidebar colour read as a floating box
       instead of a surface. Spacing now lives INSIDE each region, the way the
       main window does it. -->
  <DockPanel>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource SeparatorColour}"
            BorderThickness="0,1,0,0"
            Padding="16,10">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Padding="14,4" Command="{Binding CancelCommand}"/>
        <Button Content="Save" Padding="14,4" Command="{Binding SaveCommand}"/>
      </StackPanel>
    </Border>

    <!-- The strip runs down the LEFT.
         Across the top it wrapped onto three ragged lines once all six pages
         existed, because the header text is wider than the dialog. A vertical
         list cannot wrap, reads as a list of places rather than a row of
         controls, and matches the main window's own left-hand sidebar. -->
    <!-- PanelBackground is the same brush the main window's sidebar uses, so
         the strip reads as the same kind of surface. Set on the TabControl
         rather than on the strip's internal presenter, which would mean
         reaching into the Fluent template; the page content below paints
         AppBackground back over the right-hand side. -->
    <TabControl TabStripPlacement="Left" Padding="0"
                Background="{DynamicResource PanelBackground}">

      <TabControl.Styles>
        <!-- Styled to match the sidebar: transparent, left-aligned, dim until
             chosen. The Fluent default draws a heavy pill that fights the rest
             of the application. -->
        <!-- OUR OWN TEMPLATE, not Fluent's.
             Removing the selected fill and then the SemiBold weight both failed
             to stop the label shifting as pages were clicked, and Fluent's
             TabItem template cannot be inspected from here — so rather than
             guess at it a third time, this replaces it with one where nothing
             state-dependent touches layout.

             The accent bar is OVERLAID in a Panel, exactly as the main window
             draws a selected row's edge bar: showing and hiding it moves
             nothing, because it never occupied space. The ContentPresenter's
             margin is identical in every state. Only Foreground changes. -->
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
          <Setter Property="Foreground" Value="{DynamicResource ViewDimText}"/>
          <Setter Property="MinWidth" Value="150"/>
          <Setter Property="Template">
            <ControlTemplate>
              <Panel Background="Transparent">
                <Border Name="Accent" Width="3" HorizontalAlignment="Left"
                        Margin="0,5" CornerRadius="2"
                        Background="{DynamicResource AccentColour}"
                        IsVisible="False"/>
                <ContentPresenter Content="{TemplateBinding Header}"
                                  RecognizesAccessKey="False"
                                  Margin="16,7"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
              </Panel>
            </ControlTemplate>
          </Setter>
        </Style>

        <Style Selector="TabItem:selected">
          <Setter Property="Foreground" Value="{DynamicResource ViewText}"/>
        </Style>
        <Style Selector="TabItem:selected /template/ Border#Accent">
          <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="TabItem:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource ViewText}"/>
        </Style>

      </TabControl.Styles>

      <!-- General comes first, as it does in Dolphin. Its Previews and
           Confirmations tabs are not here yet: they arrive with the plumbing
           that makes them do something. -->
      <TabItem Header="General">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="Sorting"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding NaturalSorting}">
              <StackPanel>
                <TextBlock Text="Natural sorting"/>
                <TextBlock Text="file2 before file10, rather than file1, file10, file2."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>

            <CheckBox Content="Case sensitive"
                      Margin="24,0,0,0"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsEnabled="{Binding CanSetCaseSensitivity}"
                      IsChecked="{Binding CaseSensitiveSorting}"/>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Behaviour"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding RememberViewPerFolder}">
              <StackPanel>
                <TextBlock Text="Remember the view for each folder"/>
                <TextBlock Text="Off, every folder uses the same view. On, a folder keeps the layout, sort and grouping you last gave it. Stored centrally rather than written into your folders, but a .directory file Dolphin already wrote is still honoured."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>

            <CheckBox Content="Show tooltips on rows"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowTooltips}"/>

            <CheckBox Content="Tab switches between split panes"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding TabSwitchesSplitPanes}"/>

            <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ClosingSplitDiscardsOtherPane}">
              <StackPanel>
                <TextBlock Text="Closing the split discards the other pane"/>
                <TextBlock Text="Off, Heimdall remembers what it was showing so reopening lands back in place."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Status bar"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Show the status bar"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowStatusBar}"/>

            <CheckBox Content="Show free space"
                      Margin="24,0,0,0"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsEnabled="{Binding CanSetFreeSpace}"
                      IsChecked="{Binding ShowFreeSpace}"/>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Previews"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Show thumbnails"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowPreviews}"/>

            <Grid ColumnDefinitions="*,90" Margin="24,0,0,0"
                  IsEnabled="{Binding CanSetPreviewLimits}">
              <TextBlock Grid.Column="0" Text="Skip local files larger than (MB)"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSmall}"/>
              <TextBox Grid.Column="1" Text="{Binding MaxLocalPreviewMegabytes}"
                       PlaceholderText="no limit"
                       FontSize="{DynamicResource FontSizeSmall}"/>
            </Grid>

            <Grid ColumnDefinitions="*,90" Margin="24,0,0,0"
                  IsEnabled="{Binding CanSetPreviewLimits}">
              <TextBlock Grid.Column="0" Text="Skip network files larger than (MB)"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSmall}"/>
              <TextBox Grid.Column="1" Text="{Binding MaxRemotePreviewMegabytes}"
                       PlaceholderText="no limit"
                       FontSize="{DynamicResource FontSizeSmall}"/>
            </Grid>

            <TextBlock Text="A thumbnail on a mounted share pulls the whole file over the network, which is why the two limits are separate. Blank or 0 means no limit."
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap" Margin="24,0,0,0"/>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Ask for confirmation before"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Moving files to trash"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ConfirmMoveToTrash}"/>

            <CheckBox Content="Deleting files permanently"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ConfirmPermanentDelete}"/>

            <CheckBox Content="Closing a window with several tabs open"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ConfirmClosingMultipleTabs}"/>
          </StackPanel>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Startup">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="When Heimdall opens"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="6">
            <RadioButton GroupName="startup"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding RestoreLastSession}">
              <StackPanel>
                <TextBlock Text="Restore folders, tabs and window from last time"/>
                <TextBlock Text="The default. Forgetting these is the thing this replaces."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </RadioButton>

            <RadioButton Content="Open the home folder" GroupName="startup"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding StartInHome}"/>

            <RadioButton Content="Open a specific folder" GroupName="startup"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding StartInSpecificFolder}"/>
          </StackPanel>

          <TextBox Text="{Binding StartupFolder}"
                   PlaceholderText="/home/…"
                   IsEnabled="{Binding CanEditStartupFolder}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Margin="24,0,0,0"/>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="How it opens"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Begin in split view"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding BeginInSplitView}"/>

            <CheckBox Content="Show the filter bar"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowFilterBar}"/>

            <CheckBox Content="Start with the location bar editable"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding LocationBarEditable}"/>

            <CheckBox Content="Show the full path in the title bar"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowFullPathInTitleBar}"/>
          </StackPanel>

          <TextBlock Text="Changes to how it opens apply on the next launch."
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"
                     TextWrapping="Wrap"/>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="View modes">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="Text"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="6">
            <ComboBox ItemsSource="{Binding AvailableFonts}"
                      SelectedItem="{Binding SelectedFont}"
                      HorizontalAlignment="Stretch"
                      FontSize="{DynamicResource FontSizeSmall}"/>
            <TextBlock Text="The first entry uses whatever Plasma is set to. Sizes still come from the per-pane scale, so this changes the face only."
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Details view"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding AbsoluteDates}">
              <StackPanel>
                <TextBlock Text="Absolute dates"/>
                <TextBlock Text="2026-07-26 14:30 for everything, instead of dropping the parts you can infer from today."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>

            <CheckBox Content="Show item counts for folders"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowFolderItemCounts}"/>
          </StackPanel>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Navigation">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="Open files and folders with"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="6">
            <RadioButton GroupName="activation"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding OpenWithSystem}">
              <StackPanel>
                <TextBlock Text="Whatever the desktop is set to"/>
                <TextBlock Text="Follows Plasma's own single-click setting, so this matches Dolphin without being configured twice."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </RadioButton>

            <RadioButton Content="A single click" GroupName="activation"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding OpenWithSingle}"/>

            <RadioButton Content="A double click" GroupName="activation"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding OpenWithDouble}"/>
          </StackPanel>

          <TextBlock Text="Takes effect immediately — the setting is read when you click, not when a row is drawn."
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"
                     TextWrapping="Wrap"/>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Context menu">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="Show these in the right-click menu"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Copy to" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuCopyTo}"/>
            <CheckBox Content="Move to" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuMoveTo}"/>
            <CheckBox Content="Open in new tab" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuOpenInNewTab}"/>
            <CheckBox Content="Add to places" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuAddToPlaces}"/>
            <CheckBox Content="Copy location" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuCopyLocation}"/>
            <CheckBox Content="Duplicate" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuDuplicate}"/>
            <CheckBox Content="Sort by" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuSortBy}"/>
          </StackPanel>

          <TextBlock Text="Hiding an entry does not remove the command — its keyboard shortcut still works."
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"
                     TextWrapping="Wrap"/>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Trash">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="This deletes files permanently, on its own, while Heimdall is running. Both options are off unless you turn them on."
                     FontSize="{DynamicResource FontSizeSmall}"
                     TextWrapping="Wrap"/>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Delete items after a number of days"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding DeleteOldTrash}"/>

            <Grid ColumnDefinitions="*,90" Margin="24,0,0,0"
                  IsEnabled="{Binding CanSetTrashAge}">
              <TextBlock Grid.Column="0" Text="Days to keep"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSmall}"/>
              <TextBox Grid.Column="1" Text="{Binding DeleteAfterDays}"
                       FontSize="{DynamicResource FontSizeSmall}"/>
            </Grid>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Limit the trash to a share of the disk"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding LimitTrashSize}"/>

            <Grid ColumnDefinitions="*,90" Margin="24,0,0,0"
                  IsEnabled="{Binding CanSetTrashSize}">
              <TextBlock Grid.Column="0" Text="Percent of the disk"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSmall}"/>
              <TextBox Grid.Column="1" Text="{Binding MaxPercentOfDisk}"
                       FontSize="{DynamicResource FontSizeSmall}"/>
            </Grid>

            <StackPanel Spacing="6" Margin="24,0,0,0"
                        IsEnabled="{Binding CanSetTrashSize}">
              <TextBlock Text="When it is exceeded"
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"/>

              <RadioButton Content="Just say so" GroupName="trashlimit"
                           FontSize="{DynamicResource FontSizeSmall}"
                           IsChecked="{Binding LimitActionWarn}"/>
              <RadioButton Content="Delete the oldest until it fits" GroupName="trashlimit"
                           FontSize="{DynamicResource FontSizeSmall}"
                           IsChecked="{Binding LimitActionOldest}"/>
              <RadioButton Content="Delete the largest until it fits" GroupName="trashlimit"
                           FontSize="{DynamicResource FontSizeSmall}"
                           IsChecked="{Binding LimitActionLargest}"/>
            </StackPanel>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="The trash is shared with the rest of the desktop, so this also removes what Dolphin and other applications put there — the same as Dolphin's own setting. Items whose deletion date cannot be read are always left alone. Files deleted from another drive live in a trash on that drive and are not covered."
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"
                     TextWrapping="Wrap"/>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

  </DockPanel>
</Window>
