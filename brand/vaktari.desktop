[Desktop Entry]
Type=Application
Version=1.0

Name=Vaktari
GenericName=File Manager
Comment=Browse, search and share files

# %F rather than %f: Vaktari opens several paths at once, and the desktop
# passes them as separate arguments.
Exec=vaktari %F
Icon=vaktari
Terminal=false
StartupNotify=true

# In [Desktop Entry], where it means something. It sat at the bottom of
# [Desktop Action Home], where the specification gives it no meaning at all, so
# nothing read it. The value is the WM_CLASS Program.cs actually sets — it was
# naming the assembly, which is not what the window reports.
StartupWMClass=vaktari

# inode/directory is what makes this offerable as the default file manager;
# without it the system will not list Vaktari when you go to change it.
MimeType=inode/directory;

Categories=System;Utility;Core;FileTools;FileManager;
Keywords=files;folders;browse;explorer;manager;network;share;

Actions=NewWindow;Home;

[Desktop Action NewWindow]
Name=Open a New Window
Exec=vaktari

[Desktop Action Home]
Name=Open Home Folder
Exec=vaktari %h
