<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- Overridden by CI from the tag (`-p:Version=0.3.1`). The default marks a
         local build as exactly that: a binary reporting 0.0.0-dev is one nobody
         released, which is the useful thing to know when a machine has more than
         one install. -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)-dev</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- AOT compatibility is checked at build time in every project, so a
       trim-hostile dependency shows up as a warning now rather than as a
       runtime failure in a published build months from now. -->
  <!-- Avalonia 12 defaults this to true, but AOT *requires* compiled bindings —
       reflection bindings may not resolve without the full runtime — so it is
       stated rather than inherited. A framework default is not a decision. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

</Project>
